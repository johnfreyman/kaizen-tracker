{
  "permissions": {
    "allow": [
      "Bash(grep -iE \"\\(\\\\.env$|\\\\.env\\\\.|secret|key|\\\\.pem|\\\\.DS_Store|\\\\.claude|dist/\\)\")",
      "Bash(npx tsc *)",
      "Bash(git remote *)",
      "Bash(git add *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__[Ss]upabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/supabase-test-project-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
